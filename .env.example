# Copy to .env in the repository root for Docker Compose.
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# Java heap limit per recognition process.
AUDIVERIS_HEAP=2g
# Optional. Defaults to http://localhost:<BACKEND_PORT>.
# For another PC, set the backend PC's LAN address here.
# VITE_API_BASE=http://localhost:8000
